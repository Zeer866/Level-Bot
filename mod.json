{
	"geode": "5.11.2",
	"gd": {
		"android": "2.2081"
	},
	"version": "v1.4.0",
	"id": "zeer866.levelbot",
	"name": "Level Bot",
	"developer": "Zeer866",
	"description": "Bot de niveles, cuentas, editor de stats, likes/dislikes y scripts para tu GDPS.",
	"settings": {
		"pause": {
			"type": "float",
			"name": "Pausa entre niveles (segundos)",
			"description": "0 = sube el siguiente apenas el servidor confirme el anterior.",
			"default": 0,
			"min": 0,
			"max": 600,
			"control": { "input": true, "slider": true }
		},
		"objects": {
			"type": "int",
			"name": "Objetos por nivel",
			"default": 200,
			"min": 20,
			"max": 30000,
			"control": { "input": true, "slider": true }
		},
		"name-prefix": {
			"type": "string",
			"name": "Prefijo del nombre",
			"default": "Nivel Auto"
		},
		"level-desc": {
			"type": "string",
			"name": "Descripción de los niveles",
			"default": "Generado automáticamente por Level Bot"
		},
		"acc-prefix": {
			"type": "string",
			"name": "Prefijo de usuario (máx. 11)",
			"default": "Zeer"
		},
		"acc-start": {
			"type": "int",
			"name": "Número inicial",
			"default": 1,
			"min": 1,
			"max": 100000
		},
		"acc-password": {
			"type": "string",
			"name": "Contraseña de las cuentas",
			"default": "Test1234"
		},
		"acc-email-domain": {
			"type": "string",
			"name": "Dominio del correo",
			"description": "Los correos serán usuario@dominio",
			"default": "gmail.com",
			"one-of": ["gmail.com", "outlook.com", "hotmail.com", "yahoo.com", "example.com"]
		},
		"acc-pause": {
			"type": "float",
			"name": "Pausa entre cuentas (segundos)",
			"default": 1,
			"min": 0.2,
			"max": 60,
			"control": { "input": true, "slider": true }
		},
		"rate-pause": {
			"type": "float",
			"name": "Pausa entre votos (segundos)",
			"default": 1,
			"min": 0.2,
			"max": 60,
			"control": { "input": true, "slider": true }
		}
	}
}
